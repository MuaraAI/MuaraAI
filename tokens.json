{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Light-first design system with flowing oceanic currents, fresh water-mist canvas, marine ink typography, and luminous tropical cyan accents. Local craft flows global.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.145,
          0.227
        ],
        "hex": "#0b253a"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.278,
          0.38,
          0.459
        ],
        "hex": "#476175"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.012,
          0.412,
          0.631
        ],
        "hex": "#0369a1"
      }
    },
    "accent-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.027,
          0.349,
          0.522
        ],
        "hex": "#075985"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "surface-alt": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.941,
          0.969,
          0.98
        ],
        "hex": "#f0f7fa"
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.973,
          0.98,
          0.988
        ],
        "hex": "#f8fafc"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.463,
          0.431
        ],
        "hex": "#0f766e"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.604,
          0.204,
          0.071
        ],
        "hex": "#9a3412"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.745,
          0.071,
          0.235
        ],
        "hex": "#be123c"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
    "xxl": {
      "$value": {
        "value": 80,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Grotesk",
        "fontSize": {
          "value": 3.25,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.03,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Grotesk",
        "fontSize": {
          "value": 2.25,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Grotesk",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 1.125,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    },
    "mono-label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Grotesk",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.05,
          "unit": "em"
        }
      }
    }
  }
}
